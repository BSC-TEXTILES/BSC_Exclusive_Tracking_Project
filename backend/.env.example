# BSC Exclusive Tracking — Backend configuration (local, Render and Supabase)

PORT=4000

# PostgreSQL connection string.
# Local dev:  postgresql://postgres:postgres@localhost:5432/bsc_exclusive_tracking
# Supabase:   your project's Direct connection string (Settings → Database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bsc_exclusive_tracking

# Set to "true" to force SSL (auto-enabled for supabase/rds/render hosts)
DB_SSL=false

# JWT session signing secret (32+ characters — REQUIRED in production!)
SESSION_SECRET=bsc-exclusive-tracking-super-secret-key-2026-change-me

# Comma-separated list of allowed frontend origins (your deployed frontend URL)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# Evidence file storage
#   local    → files stored on the server disk (fine for local dev)
#   supabase → files stored in Supabase Storage (RECOMMENDED on Render —
#              Render's disk is ephemeral and resets on redeploy)
# ------------------------------------------------------------------
FILE_STORAGE_TYPE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=evidence

# Uploads (local storage mode only)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Auto-approval window (hours) — submissions older than this are auto-approved
AUTO_APPROVE_HOURS=1
