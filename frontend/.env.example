# BSC Exclusive Tracking — Frontend configuration

# Backend API base URL.
# Leave empty when the frontend is served by the same origin as the API,
# or when using the Vite dev proxy (localhost dev).
# Set it when the frontend is deployed separately, e.g.:
# VITE_API_URL=https://bsc-exclusive-tracking-api.onrender.com
VITE_API_URL=

# Google Maps API Key (required for live map with layers, street view, satellite view)
# Get one at https://console.cloud.google.com/apis/credentials
# Enable "Maps JavaScript API" in your Google Cloud project
VITE_GOOGLE_MAPS_API_KEY=
