{
  "name": "bsc-exclusive-process-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "BSC Exclusive - Process Compliance & Daily Audit Tracker with Supabase",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "npx tsx database/prisma/seed.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx database/prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "db:generate": "npx prisma generate",
    "supabase:init": "cd database/supabase && supabase init",
    "supabase:start": "cd database/supabase && supabase start",
    "supabase:stop": "cd database/supabase && supabase stop",
    "supabase:db-push": "cd database/supabase && supabase db push",
    "supabase:reset": "cd database/supabase && supabase db reset"
  },
  "prisma": {
    "schema": "database/prisma/schema.prisma",
    "seed": "npx tsx database/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.115.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "jose": "^6.2.11",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
