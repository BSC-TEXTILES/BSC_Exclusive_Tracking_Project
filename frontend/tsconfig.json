{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@backend/*": ["../backend/*"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"],
      "jose": ["./node_modules/jose"],
      "bcryptjs": ["./node_modules/bcryptjs"],
      "zod": ["./node_modules/zod"],
      "next/headers": ["./node_modules/next/headers"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../backend/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
