// Process Tracker / Compliance Tracker - Prisma Schema
// BSC Exclusive - Enterprise Compliance Tracking System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CheckpointStatus {
  PENDING
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  NOT_APPLICABLE
  OVERDUE
}

enum ComplianceStatus {
  FULLY_FOLLOWED
  PARTIALLY_FOLLOWED
  NOT_FOLLOWED
  NO_TRANSACTION
  YET_TO_IMPLEMENT
}

enum AccuracyStatus {
  FULLY_ACCURATE
  PARTLY_ACCURATE
  INACCURATE
  NA
}

enum AssignmentFrequency {
  DAILY
  WEEKLY
  MONTHLY
  ONE_TIME
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

// ============================================================
// AUTHENTICATION & USERS
// ============================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                 String     @id @default(cuid())
  employeeCode       String     @unique @map("employee_code")
  fullName           String     @map("full_name")
  email              String     @unique
  phone              String?
  username           String     @unique
  passwordHash       String     @map("password_hash")
  roleId             String     @map("role_id")
  departmentId       String?    @map("department_id")
  status             UserStatus @default(ACTIVE)
  profileImage       String?    @map("profile_image")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  createdBy          String?    @map("created_by")
  updatedBy          String?    @map("updated_by")
  reportingManagerId String?    @map("reporting_manager_id")

  role             Role        @relation(fields: [roleId], references: [id])
  department       Department? @relation(fields: [departmentId], references: [id])
  reportingManager User?       @relation("ReportingManager", fields: [reportingManagerId], references: [id])

  sessions                      Session[]
  checkpointAssignments         CheckpointAssignment[]
  checkpointSubmissions         CheckpointSubmission[]
  evidenceFiles                 EvidenceFile[]
  reviewedSubmissions           CheckpointSubmission[] @relation("ReviewedBy")
  auditLogs                     AuditLog[]
  notifications                 Notification[]
  userLocations                 UserLocation[]
  createdCheckpoints            Checkpoint[]           @relation("CheckpointCreatedBy")
  updatedCheckpoints            Checkpoint[]           @relation("CheckpointUpdatedBy")
  supervisorProfile             SupervisorProfile?
  supervisorDepartments         SupervisorDepartment[]
  supervisedEmployees           SupervisorEmployee[]   @relation("SupervisorEmployees")
  managedEmployees              SupervisorEmployee[]   @relation("ManagedEmployees")
  supervisorProjects            SupervisorProject[]
  supervisorApprovalsSupervised SupervisorApproval[]   @relation("SupervisorApprovalSupervisor")
  supervisorApprovalsRequested  SupervisorApproval[]   @relation("SupervisorApprovalRequestedBy")
  supervisorApprovalsEscalated  SupervisorApproval[]   @relation("SupervisorApprovalEscalatedTo")
  supervisorActivities          SupervisorActivity[]
  supervisorProfileManaged      SupervisorProfile[]    @relation("SupervisorProfileReportingManager")
  reportingEmployees            User[]                 @relation("ReportingManager")

  @@index([email])
  @@index([username])
  @@index([employeeCode])
  @@index([roleId])
  @@index([departmentId])
  @@index([reportingManagerId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

// ============================================================
// ORGANIZATION
// ============================================================

model Department {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  description String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  users                 User[]
  modules               Module[]
  supervisorDepartments SupervisorDepartment[]
  SupervisorEmployee    SupervisorEmployee[]

  @@map("departments")
}

model Location {
  id        String       @id @default(cuid())
  name      String       @unique
  code      String       @unique
  address   String?
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  userLocations UserLocation[]

  @@map("locations")
}

model UserLocation {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  locationId String   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@map("user_locations")
}

// ============================================================
// MODULES & CHECKPOINTS
// ============================================================

model Module {
  id           String       @id @default(cuid())
  departmentId String       @map("department_id")
  name         String
  slug         String       @unique
  description  String?
  displayOrder Int          @default(0) @map("display_order")
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  department         Department          @relation(fields: [departmentId], references: [id])
  checkpoints        Checkpoint[]
  supervisorProjects SupervisorProject[]

  @@index([departmentId])
  @@index([slug])
  @@map("modules")
}

model Checkpoint {
  id                         String       @id @default(cuid())
  moduleId                   String       @map("module_id")
  title                      String
  description                String?
  score                      Int          @default(5)
  isAccuracyRequired         Boolean      @default(false) @map("is_accuracy_required")
  isCorrectiveActionRequired Boolean      @default(false) @map("is_corrective_action_required")
  isPhotoRequired            Boolean      @default(false) @map("is_photo_required")
  displayOrder               Int          @default(0) @map("display_order")
  status                     EntityStatus @default(ACTIVE)
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")
  createdById                String?      @map("created_by")
  updatedById                String?      @map("updated_by")

  module        Module                 @relation(fields: [moduleId], references: [id])
  createdByUser User?                  @relation("CheckpointCreatedBy", fields: [createdById], references: [id])
  updatedByUser User?                  @relation("CheckpointUpdatedBy", fields: [updatedById], references: [id])
  assignments   CheckpointAssignment[]
  submissions   CheckpointSubmission[]

  @@index([moduleId])
  @@map("checkpoints")
}

// ============================================================
// ASSIGNMENTS & SUBMISSIONS
// ============================================================

model CheckpointAssignment {
  id           String              @id @default(cuid())
  checkpointId String              @map("checkpoint_id")
  userId       String              @map("user_id")
  assignedDate DateTime            @map("assigned_date") @db.Date
  dueDate      DateTime?           @map("due_date")
  frequency    AssignmentFrequency @default(DAILY)
  status       EntityStatus        @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  checkpoint  Checkpoint             @relation(fields: [checkpointId], references: [id])
  user        User                   @relation(fields: [userId], references: [id])
  submissions CheckpointSubmission[]

  @@unique([userId, checkpointId, assignedDate])
  @@index([userId])
  @@index([checkpointId])
  @@index([assignedDate])
  @@index([userId, assignedDate])
  @@map("checkpoint_assignments")
}

model CheckpointSubmission {
  id             String           @id @default(cuid())
  checkpointId   String           @map("checkpoint_id")
  userId         String           @map("user_id")
  assignmentId   String?          @map("assignment_id")
  submissionDate DateTime         @map("submission_date") @db.Date
  status         CheckpointStatus @default(PENDING)
  submittedAt    DateTime?        @map("submitted_at")
  approvedAt     DateTime?        @map("approved_at")
  rejectedAt     DateTime?        @map("rejected_at")
  reviewedById   String?          @map("reviewed_by")
  reviewComment  String?          @map("review_comment")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  checkpoint         Checkpoint            @relation(fields: [checkpointId], references: [id])
  user               User                  @relation(fields: [userId], references: [id])
  assignment         CheckpointAssignment? @relation(fields: [assignmentId], references: [id])
  reviewedBy         User?                 @relation("ReviewedBy", fields: [reviewedById], references: [id])
  answer             SubmissionAnswer?
  evidence           EvidenceFile[]
  supervisorApproval SupervisorApproval?

  @@index([userId])
  @@index([checkpointId])
  @@index([submissionDate])
  @@index([status])
  @@index([userId, submissionDate])
  @@index([userId, checkpointId, submissionDate])
  @@map("checkpoint_submissions")
}

model SubmissionAnswer {
  id               String            @id @default(cuid())
  submissionId     String            @unique @map("submission_id")
  complianceStatus ComplianceStatus? @map("compliance_status")
  accuracyStatus   AccuracyStatus?   @map("accuracy_status")
  comments         String?
  correctiveAction String?           @map("corrective_action")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  submission CheckpointSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_answers")
}

model EvidenceFile {
  id           String   @id @default(cuid())
  submissionId String   @map("submission_id")
  uploadedById String   @map("uploaded_by")
  originalName String   @map("original_name")
  storedName   String   @map("stored_name")
  mimeType     String   @map("mime_type")
  fileSize     Int      @map("file_size")
  storagePath  String   @map("storage_path")
  publicUrl    String?  @map("public_url")
  createdAt    DateTime @default(now()) @map("created_at")

  submission CheckpointSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadedBy User                 @relation(fields: [uploadedById], references: [id])

  @@index([submissionId])
  @@map("evidence_files")
}

// ============================================================
// AUDIT & SYSTEM
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([entityType])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false) @map("is_read")
  linkUrl   String?  @map("link_url")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  category  String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================================
// SUPERVISOR MODELS
// ============================================================

model SupervisorProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique @map("user_id")
  designation        String?
  joiningDate        DateTime? @map("joining_date") @db.Date
  reportingManagerId String?   @map("reporting_manager_id")
  bio                String?
  specialization     String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user             User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportingManager User? @relation("SupervisorProfileReportingManager", fields: [reportingManagerId], references: [id])

  @@index([userId])
  @@map("supervisor_profiles")
}

model SupervisorDepartment {
  id             String       @id @default(cuid())
  supervisorId   String       @map("supervisor_id")
  departmentId   String       @map("department_id")
  isPrimary      Boolean      @default(false) @map("is_primary")
  assignedDate   DateTime     @default(now()) @map("assigned_date") @db.Date
  unassignedDate DateTime?    @map("unassigned_date") @db.Date
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  supervisor User       @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([supervisorId, departmentId])
  @@index([supervisorId])
  @@index([departmentId])
  @@map("supervisor_departments")
}

model SupervisorEmployee {
  id               String       @id @default(cuid())
  supervisorId     String       @map("supervisor_id")
  employeeId       String       @map("employee_id")
  departmentId     String       @map("department_id")
  assignedDate     DateTime     @default(now()) @map("assigned_date") @db.Date
  unassignedDate   DateTime?    @map("unassigned_date") @db.Date
  status           EntityStatus @default(ACTIVE)
  assignmentReason String?      @map("assignment_reason")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  supervisor User       @relation("SupervisorEmployees", fields: [supervisorId], references: [id], onDelete: Cascade)
  employee   User       @relation("ManagedEmployees", fields: [employeeId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([supervisorId, employeeId])
  @@index([supervisorId])
  @@index([employeeId])
  @@index([departmentId])
  @@map("supervisor_employees")
}

model SupervisorProject {
  id             String       @id @default(cuid())
  supervisorId   String       @map("supervisor_id")
  moduleId       String       @map("module_id")
  assignedDate   DateTime     @default(now()) @map("assigned_date") @db.Date
  unassignedDate DateTime?    @map("unassigned_date") @db.Date
  status         EntityStatus @default(ACTIVE)
  responsibility String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  supervisor User   @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  module     Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([supervisorId, moduleId])
  @@index([supervisorId])
  @@index([moduleId])
  @@map("supervisor_projects")
}

model SupervisorApproval {
  id                 String         @id @default(cuid())
  submissionId       String         @unique @map("submission_id")
  supervisorId       String         @map("supervisor_id")
  status             ApprovalStatus @default(PENDING)
  requestType        String?
  requestedById      String?        @map("requested_by_id")
  approvalDate       DateTime?      @map("approval_date")
  rejectionReason    String?        @map("rejection_reason")
  supervisorComments String?        @map("supervisor_comments")
  escalationLevel    Int            @default(0) @map("escalation_level")
  escalatedToId      String?        @map("escalated_to_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  submission  CheckpointSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  supervisor  User                 @relation("SupervisorApprovalSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)
  requestedBy User?                @relation("SupervisorApprovalRequestedBy", fields: [requestedById], references: [id])
  escalatedTo User?                @relation("SupervisorApprovalEscalatedTo", fields: [escalatedToId], references: [id])

  @@index([submissionId])
  @@index([supervisorId])
  @@index([status])
  @@index([requestedById])
  @@index([escalatedToId])
  @@map("supervisor_approvals")
}

model SupervisorActivity {
  id           String   @id @default(cuid())
  supervisorId String   @map("supervisor_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  details      Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  supervisor User @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  @@index([supervisorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("supervisor_activities")
}
