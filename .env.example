# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# Application
NEXT_PUBLIC_APP_NAME="BSC Exclusive"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"

# Session / Auth
SESSION_SECRET="your-session-secret-at-least-32-characters"

# File Storage
FILE_STORAGE_TYPE="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="10"

# Initial Admin (used by seed script)
INITIAL_ADMIN_EMAIL="admin@bscexclusive.com"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="Admin@123456"
